<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%d{HH:mm:ss} %-5level [%t] %c{1} - %msg%n"/>
        </Console>

        <File name="RunFile"
              fileName="logs/test-run-${date:yyyy-MM-dd_HH-mm-ss-SSS}.log"
              append="false">
            <PatternLayout
                    pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1} - %msg%n"/>
        </File>

    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RunFile"/>
        </Root>
    </Loggers>

</Configuration>
